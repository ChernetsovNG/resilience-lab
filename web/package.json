{
  "name": "resilience-lab-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "api:types": "openapi-typescript ../apps/server/openapi.json -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../apps/server/openapi.json -o src/api/schema.d.ts --check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@typescript/old": "npm:typescript@6.0.2",
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "minimatch": "^11.0.3"
  }
}
