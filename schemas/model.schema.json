                                "denominator": 1.0,
                                "numerator": 1.0,
                                "symbol": "ms"
                              },
                              {
                                "denominator": 1.0,
                                "numerator": 1000.0,
                                "symbol": "s"
                              },
                              {
                                "denominator": 1.0,
                                "numerator": 60000.0,
                                "symbol": "min"
                              }
                            ]
                          }
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Required for lognormal only. Units: ms, s, min. Canonical value (milliseconds): > 0; numeric bounds are checked by the core.",
                      "title": "Standard deviation"
                    }
                  },
                  "required": [
                    "kind",
                    "mean"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local processing time of one attempt.",
              "title": "Processing time"
            },
            "type": {
              "const": "process"
            }
          },
          "required": [
            "type"
