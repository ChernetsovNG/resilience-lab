                      "title": "Mean",
                      "type": "string",
                      "x-quantity": {
                        "dimension": "DURATION",
                        "minimum": 0.0,
                        "units": [
                          {
                            "denominator": 1.0,
                            "numerator": 1.0,
                            "symbol": "ms"
                          },
                          {
                            "denominator": 1.0,
                            "numerator": 1000.0,
                            "symbol": "s"
                          },
                          {
                            "denominator": 1.0,
                            "numerator": 60000.0,
                            "symbol": "min"
                          }
                        ]
                      }
                    },
                    "stdDev": {
                      "anyOf": [
                        {
                          "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[eE][-+]?[0-9]+)?(?:ms|s|min)$",
